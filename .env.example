# --- Database (separate from CodeWorld; never reuse its DATABASE_URL) ---
# Production: paste the connection string for THIS project's own Supabase/Postgres project.
# Local dev: leave empty to use the file-backed SQLite database at ./data/simlife.db.
SIMLIFE_DATABASE_URL=

# --- Ports (must differ from CodeWorld's 3000/4000) ---
# Production hosts normally provide PORT automatically. SIMLIFE_PORT is the
# local/default fallback; production binds to 0.0.0.0 unless overridden.
SIMLIFE_PORT=4101
# SIMLIFE_HOST=127.0.0.1
VITE_SIMLIFE_API_TARGET=http://127.0.0.1:4101

# --- Google sign-in (district accounts) ---
# Google Cloud Console -> OAuth "Web application" client.
# Authorized JavaScript origins: http://127.0.0.1:3100 (add deployed URL later).
# Leave SIMLIFE_GOOGLE_CLIENT_ID empty to disable the Google button (demo login only).
SIMLIFE_GOOGLE_CLIENT_ID=
SIMLIFE_ALLOWED_GOOGLE_DOMAIN=tcitys.org
SIMLIFE_TEACHER_EMAILS=leej@tcitys.org

# --- Sessions ---
# SIMLIFE_SESSION_SECRET=generate-a-long-random-value

# --- Demo auth (development only) ---
# Enabled ONLY when this is "true" AND NODE_ENV is not "production".
# The server refuses demo logins in production regardless of this flag.
SIMLIFE_DEMO_AUTH=true

# --- Market data (server-side only; never expose keys to the browser) ---
# "mock" (default, local dev + tests) or "finnhub" (free delayed quotes, needs key below).
SIMLIFE_QUOTE_PROVIDER=mock
# Free key from https://finnhub.io (signup → free plan → API key). Required for finnhub mode.
# SIMLIFE_MARKET_API_KEY=

# --- Classroom savings interest ---
# Default benchmark: 3.40% APY, matching Marcus Online Savings on 2026-09-07.
# APY is variable in the real world; update these together when the class rate changes.
SIMLIFE_SAVINGS_APY_BPS=340
SIMLIFE_SAVINGS_RATE_LABEL=High-yield classroom benchmark · Marcus Online Savings
SIMLIFE_SAVINGS_RATE_AS_OF=2026-09-07
