{
  "name": "simlife-investing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "SIMLIFE_PORT=4101 tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 3100 --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "pretest": "node scripts/require-node.mjs",
    "test": "node --import tsx --test server/ledger.test.ts server/trades.test.ts",
    "seed": "tsx server/seed.ts",
    "seed:third": "tsx server/seed-third-period.ts",
    "seed:fourth": "tsx server/seed-fourth-period.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "google-auth-library": "^10.1.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
